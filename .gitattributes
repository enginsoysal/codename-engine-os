* text=auto
*.md text eol=lf
*.py text eol=lf
*.h text eol=lf
*.inc text eol=lf
*.c text eol=lf
*.S text eol=lf
*.ld text eol=lf
*.txt text eol=lf
*.log text eol=lf
*.json text eol=lf
LICENSE text eol=lf

# Preserve upstream BearSSL source formatting and line endings.
third_party/bearssl/** text eol=lf -whitespace
# Keep the digest-pinned public trust bundle identical on Windows checkouts.
third_party/mozilla-ca/** text eol=lf
third_party/inter/Inter.ttf binary
third_party/inter/METADATA.pb text eol=lf
third_party/inter/OFL.txt whitespace=-blank-at-eol
.gitattributes text eol=lf
*.mjs text eol=lf
*.bmp binary
*.zip binary
*.wav binary

# Preserve digest-pinned upstream miniz bytes, including its license line endings.
third_party/miniz/** -text -whitespace

# Preserve original M8 upstream packages and decoder sources byte for byte.
third_party/7zip/** -text -whitespace
third_party/libmspack/** -text -whitespace
*.msi binary
*.xz binary

# M8 serial proofs retain their captured line endings and measured hashes.
evidence/M8/**/*.log -text -whitespace

evidence/M9/**/*.log -text -whitespace

evidence/M9.1/**/*.log -text -whitespace
